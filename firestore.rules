rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Perfis de usuários autenticados
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if true;
    }

    // Permitir leitura e escrita pública/autenticada das métricas e posts do CSSJD
    match /monthly_metrics/{metricId} {
      allow read, write: if true;
    }

    match /social_posts/{postId} {
      allow read, write: if true;
    }

    match /dashboard_comments/{commentId} {
      allow read, write: if true;
    }

    match /report_edits/{editId} {
      allow read, write: if true;
    }
  }
}
